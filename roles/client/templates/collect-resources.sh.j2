#!/usr/bin/env bash
set -euo pipefail

MODE="${1:-server}"
DURATION="${2:-300}"
INTERVAL="${3:-1}"

RESULTS_DIR="/vagrant/results"
mkdir -p "$RESULTS_DIR"

TS="$(date +%Y%m%d-%H%M%S)"
OUT="$RESULTS_DIR/${MODE}-resources-${TS}.csv"

echo "timestamp,cpu_percent,mem_used_mb,mem_total_mb,mem_percent,load_1m" > "$OUT"

read_cpu() {
  awk '/^cpu / {
    idle=$5+$6
    total=0
    for (i=2; i<=NF; i++) total+=$i
    print idle,total
  }' /proc/stat
}

END=$((SECONDS + DURATION))

while [ "$SECONDS" -lt "$END" ]; do
  timestamp="$(date -Iseconds)"

  read idle1 total1 < <(read_cpu)
  sleep "$INTERVAL"
  read idle2 total2 < <(read_cpu)

  cpu_percent="$(awk -v idle1="$idle1" -v idle2="$idle2" -v total1="$total1" -v total2="$total2" '
    BEGIN {
      idle_delta = idle2 - idle1
      total_delta = total2 - total1
      if (total_delta <= 0) {
        printf "0.00"
      } else {
        printf "%.2f", (1 - idle_delta / total_delta) * 100
      }
    }
  ')"

  mem_used_mb="$(free -m | awk '/Mem:/ {print $3}')"
  mem_total_mb="$(free -m | awk '/Mem:/ {print $2}')"
  mem_percent="$(free | awk '/Mem:/ {printf "%.2f", ($3/$2)*100}')"
  load_1m="$(awk '{print $1}' /proc/loadavg)"

  echo "$timestamp,$cpu_percent,$mem_used_mb,$mem_total_mb,$mem_percent,$load_1m" >> "$OUT"
done

echo "[OK] Resource CSV: $OUT"
