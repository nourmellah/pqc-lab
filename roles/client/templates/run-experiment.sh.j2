#!/usr/bin/env bash
set -euo pipefail

MODE="${1:-baseline}"
DURATION_SECONDS="${2:-300}"
CONCURRENCY="${3:-5}"
PAUSE_SECONDS="${4:-1}"

RESULTS_DIR="/vagrant/results"
mkdir -p "$RESULTS_DIR"
chmod 777 "$RESULTS_DIR"

RUN_ID="$(date +%Y%m%d-%H%M%S)"
OUT_CSV="$RESULTS_DIR/${MODE}-${RUN_ID}.csv"
OUT_META="$RESULTS_DIR/${MODE}-${RUN_ID}.meta"

if [ "$MODE" = "baseline" ]; then
  URL="https://{{ baseline_ip }}"
  CURVE="X25519"
elif [ "$MODE" = "hybrid" ]; then
  URL="https://{{ hybrid_ip }}:4433"
  CURVE="{{ hybrid_curve }}"
else
  echo "Usage: $0 baseline|hybrid [duration_seconds] [concurrency] [pause_seconds]"
  exit 1
fi

cat > "$OUT_META" <<EOF
run_id=$RUN_ID
mode=$MODE
start_time=$(date -Is)
duration_seconds=$DURATION_SECONDS
concurrency=$CONCURRENCY
pause_seconds=$PAUSE_SECONDS
url=$URL
curve=$CURVE
client=openquantumsafe/curl
EOF

echo "timestamp,http_code,time_total,time_connect,time_appconnect,time_starttransfer,size_download" > "$OUT_CSV"

docker run --rm \
  -v "$RESULTS_DIR:/results" \
  -e URL="$URL" \
  -e OUT_FILE="/results/$(basename "$OUT_CSV")" \
  -e DURATION_SECONDS="$DURATION_SECONDS" \
  -e CONCURRENCY="$CONCURRENCY" \
  -e PAUSE_SECONDS="$PAUSE_SECONDS" \
  -e CURVE="$CURVE" \
  openquantumsafe/curl \
  sh -c '
    set -e

    end=$(( $(date +%s) + DURATION_SECONDS ))

    while [ "$(date +%s)" -lt "$end" ]; do
      i=1

      while [ "$i" -le "$CONCURRENCY" ]; do
        (
          ts=$(date -Is)
          curl -ks -o /dev/null \
            -w "$ts,%{http_code},%{time_total},%{time_connect},%{time_appconnect},%{time_starttransfer},%{size_download}\n" \
            --curves "$CURVE" "$URL" >> "$OUT_FILE"
        ) &

        i=$((i + 1))
      done

      wait
      sleep "$PAUSE_SECONDS"
    done
  '

echo "end_time=$(date -Is)" >> "$OUT_META"

echo "[OK] Finished $MODE run"
echo "[OK] CSV : $OUT_CSV"
echo "[OK] META: $OUT_META"
